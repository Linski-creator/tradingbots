//@version=5
// Gold-Tagestrend v3 – Grundregeln wie der Python-Test (bots/metals/daily.py, Regel "sma")
// und die Paper-Bots, dazu Reparaturen als Schalter (B ist an, Rest aus).
// Chart: OANDA:XAUUSD, 4h oder 1D, normale Kerzen (kein Heikin Ashi).
//
// Einstieg: Schluss über der 200er-Linie UND 50er-Linie über der 200er-Linie -> Kauf zum nächsten Open.
// Stop:     3 ATR unter dem Einstieg, danach 3 ATR unter dem besten Kurs nachgezogen (nie zurück).
// Ausstieg: Stop oder Schluss unter der 200er-Linie.
//
// Reparaturen:
//  A  Rücksetzer abwarten: nur kaufen, wenn der Kurs in den letzten 5 Kerzen die 50er-Linie
//     berührt hat UND die Kerze über dem Hoch der Vorkerze schließt (Wende bestätigt).
//  B  Nur bei steigender Trendlinie: 200er-Linie höher als vor 20 Kerzen.
//  C  Stop auf Einstieg, sobald das Hoch einer Kerze +1 R erreicht.
//  D  Stop folgt dem höchsten HOCH statt dem höchsten Schlusskurs.
//  E  Engerer Start-Stop: "Start-Stop × ATR" kleiner als 3 (z. B. 2); der nachgezogene Stop bleibt 3 ATR.
// Ergebnis der Tests (Woche 2/3): B hilft überall -> jetzt standardmäßig AN. C und D bringen nichts.
strategy("Gold-Tagestrend v3", overlay = true, initial_capital = 100000, currency = currency.USD,
     pyramiding = 0, commission_type = strategy.commission.percent, commission_value = 0.01,
     slippage = 2, process_orders_on_close = false)

modus  = input.string("Sicher", "Modus", options = ["Sicher", "Vollgas"])
useA   = input.bool(false, "A: Rücksetzer abwarten (50er-Linie berührt + Wende)")
useB   = input.bool(true, "B: Nur bei steigender 200er-Linie (Standard)")
useC   = input.bool(false, "C: Stop auf Einstieg ab +1 R (Hoch)")
useD   = input.bool(false, "D: Stop folgt dem Hoch statt dem Schlusskurs")
useSh  = input.bool(false, "Auch Short handeln (im Test schlechter)")
wkFlat = input.bool(false, "Vor dem Wochenende schließen (im Test schlechter)")
atrK   = input.float(3.0, "Nachzieh-Abstand × ATR")
atrS   = input.float(3.0, "E: Start-Stop × ATR (enger = z. B. 2)")

riskPct = modus == "Sicher" ? 1.0 : 3.0
maxLev  = modus == "Sicher" ? 5.0 : 10.0
pv      = syminfo.pointvalue
isFut   = syminfo.type == "futures"

s50  = ta.sma(close, 50)
s200 = ta.sma(close, 200)
atr  = ta.atr(20)
up   = close > s200 and s50 > s200
dn   = close < s200 and s50 < s200
thu  = dayofweek(time, "UTC") == dayofweek.thursday   // Donnerstag-Schluss -> Freitag-Open raus

// Reparatur A: Rücksetzer zur 50er-Linie und bestätigte Wende
pullL = ta.lowest(low, 5) <= s50 and close > high[1]
pullS = ta.highest(high, 5) >= s50 and close < low[1]
// Reparatur B: Steigung der 200er-Linie
rising  = s200 > s200[20]
falling = s200 < s200[20]

longOK  = up and (not useA or pullL) and (not useB or rising)
shortOK = useSh and dn and (not useA or pullS) and (not useB or falling)

var float stopPx = na
var float bestPx = na
var float riskR  = na

calcQty(dist) =>
    q = math.min(strategy.equity * riskPct / 100 / (dist * pv), strategy.equity * maxLev / (close * pv))
    isFut ? math.floor(q) : q

// Positionsführung
if strategy.position_size > 0
    ep = strategy.opentrades.entry_price(0)
    bestPx := math.max(bestPx, useD ? high : close)
    stopPx := math.max(stopPx, bestPx - atrK * atr)
    if useC and high - ep >= riskR
        stopPx := math.max(stopPx, ep)
    if close < s200
        strategy.close("Long", comment = "Trendbruch")
    else if wkFlat and thu
        strategy.close("Long", comment = "Wochenende")
if strategy.position_size < 0
    ep = strategy.opentrades.entry_price(0)
    bestPx := math.min(bestPx, useD ? low : close)
    stopPx := math.min(stopPx, bestPx + atrK * atr)
    if useC and ep - low >= riskR
        stopPx := math.min(stopPx, ep)
    if close > s200
        strategy.close("Short", comment = "Trendbruch")
    else if wkFlat and thu
        strategy.close("Short", comment = "Wochenende")

// Einstieg
if strategy.position_size == 0 and not (wkFlat and thu) and atr > 0
    if longOK
        q = calcQty(atrS * atr)
        if q > 0
            strategy.entry("Long", strategy.long, qty = q, comment = "Trend Long")
            stopPx := close - atrS * atr, bestPx := close, riskR := atrS * atr
    else if shortOK
        q = calcQty(atrS * atr)
        if q > 0
            strategy.entry("Short", strategy.short, qty = q, comment = "Trend Short")
            stopPx := close + atrS * atr, bestPx := close, riskR := atrS * atr

strategy.exit("Stop L", "Long", stop = stopPx, comment = "Stop")
strategy.exit("Stop S", "Short", stop = stopPx, comment = "Stop")

plot(s50, "SMA 50", color.new(color.orange, 0))
plot(s200, "SMA 200", color.new(color.blue, 0), 2)
plot(strategy.position_size != 0 ? stopPx : na, "Stop", color.new(color.red, 0), style = plot.style_linebr)
bgcolor(longOK ? color.new(color.green, 90) : shortOK ? color.new(color.red, 90) : na)
